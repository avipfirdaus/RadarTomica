{
  "name": "radar-tomica",
  "version": "0.1.0",
  "private": true,
  "description": "Radar Tomica Jepang — pemantau rilis Tomica & kelayakan PO (lihat docs/PRD.md)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
