# Salin ke .env lalu isi. Jangan pernah commit .env.
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
BRAND_NAME=Radar Tomica Jepang

# LLM. Pilih salah satu provider:
# 1) anthropic (default): isi ANTHROPIC_API_KEY & LLM_MODEL=claude-sonnet-4-5
# 2) openai_compat (OpenRouter :free, Groq, Gemini, GitHub Models, atau Ollama lokal):
#    - OpenRouter (gratis): LLM_BASE_URL=https://openrouter.ai/api/v1 | LLM_MODEL=qwen/qwen3-8b:free
#    - Groq (gratis):       LLM_BASE_URL=https://api.groq.com/openai/v1 | LLM_MODEL=qwen/qwen3-32b
#    - Gemini (gratis):     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai | LLM_MODEL=gemini-2.5-flash
#    - Ollama (lokal):      LLM_BASE_URL=http://localhost:11434/v1 | LLM_MODEL=qwen2.5:7b (LLM_API_KEY boleh kosong)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_MOCK=1
LLM_MONTHLY_BUDGET_USD=20

# Telegram. TELEGRAM_DRY_RUN=1 = tidak mengirim apa pun, hanya log.
TELEGRAM_BOT_TOKEN=
# Chat ID pribadi operator = satu-satunya user yang boleh menekan Setuju/Edit/Tolak & perintah.
TELEGRAM_OPERATOR_CHAT_ID=
# Mis. @radartomicajepang atau -100xxxxxxxxxx. Bot di channel cukup hak "Post messages".
TELEGRAM_CHANNEL_ID=
TELEGRAM_DRY_RUN=1

# Pengambilan halaman (PRD §3: jeda minimal 5 detik per host).
HTTP_USER_AGENT=RadarTomicaBot/0.1 (+contact via channel)
HTTP_MIN_DELAY_MS=5000

LOG_LEVEL=info
